<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        
        <FileVersion>$(ProductVersion)</FileVersion>
        <Version>$(ProductVersion)</Version>
        <LangVersion>9.0</LangVersion>
        <Authors>https://github.com/asvol</Authors>
        <Company>https://github.com/asvol</Company>
        <Copyright>https://github.com/asvol</Copyright>
        <PackageProjectUrl>https://github.com/asvol/asv-sdr</PackageProjectUrl>
        <RepositoryUrl>https://github.com/asvol/asv-sdr</RepositoryUrl>
        <PackageTags />
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Asv.Sdr\Asv.Sdr.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Libs.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>Libs.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Libs.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Libs.resx</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>
