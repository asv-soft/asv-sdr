<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    
    <FileVersion>$(ProductVersion)</FileVersion>
    <Version>1.5.1-dev.1</Version>
    <Authors>https://github.com/asvol</Authors>
    <Company>https://github.com/asvol</Company>
    <Copyright>https://github.com/asvol</Copyright>
    <PackageProjectUrl>https://github.com/asvol/asv-sdr</PackageProjectUrl>
    <RepositoryUrl>https://github.com/asvol/asv-sdr</RepositoryUrl>
    <PackageTags />
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' " />
  <ItemGroup>
    <Compile Update="Libs.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Libs.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Asv.Common" Version="$(AsvCommonVersion)" />
    <PackageReference Include="ZLogger" Version="$(ZLoggerVersion)" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Libs.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Libs.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>