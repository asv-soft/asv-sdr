<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>net5.0;net6.0;net7.0</TargetFrameworks>
	  <Version>1.0.0</Version>
	  <LangVersion>9.0</LangVersion>
	  <Authors>https://github.com/asvol</Authors>
	  <Company>https://github.com/asvol</Company>
	  <Copyright>https://github.com/asvol</Copyright>
	  <PackageProjectUrl>https://github.com/asvol/asv-sdr</PackageProjectUrl>
	  <RepositoryUrl>https://github.com/asvol/asv-sdr</RepositoryUrl>
	  <PackageTags />
	  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="BB\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Libs.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Libs.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Libs.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Libs.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
