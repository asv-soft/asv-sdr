<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             xmlns:gui="clr-namespace:Asv.Sdr.Gui"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Asv.Sdr.Gui.ModeACInterrogateView"
             x:DataType="gui:ModeACInterrogateViewModel">
    <Design.DataContext>
        <gui:ModeACInterrogateViewModel />
    </Design.DataContext>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding ConnectLms}">Connect Lms</Button>
            <Button Command="{Binding DisconnectLms}">Disconnect Lms</Button>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="TX Gain" VerticalAlignment="Center"/>
                <Slider Minimum="-69" Width="200" Maximum="10" Value="{CompiledBinding TxGain}"/>
                <TextBlock Text="{CompiledBinding TxGain}" VerticalAlignment="Center"/>
                <TextBlock Text="RX Gain" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Slider Minimum="-69" Width="200" Maximum="10" Value="{CompiledBinding RxGain}"/>
                <TextBlock Text="{CompiledBinding RxGain}" VerticalAlignment="Center"/>
                <TextBlock Text="Delay" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock Text="{CompiledBinding Dt}" VerticalAlignment="Center"/>
                <ToggleSwitch OffContent="P2 Off" OnContent="P2 On" IsChecked="{CompiledBinding OnOffP2}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <ToggleSwitch OffContent="Mode A" OnContent="Mode A/C" IsChecked="{CompiledBinding Modes}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>
        <Grid ColumnDefinitions="*,*">
            <avalonia:AvaPlot Grid.Column="0" Name="AvaPlotSh"/>
            <avalonia:AvaPlot Grid.Column="1" Name="AvaPlotLms"/>
        </Grid>
    </DockPanel>
</UserControl>
